{
  "name": "kiro-nest",
  "description": "Kiro-nest: a standalone Kiro account gateway with OpenAI/Anthropic-compatible endpoints, multi-account login, usage, and a web settings page",
  "version": "0.1.20",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dat LQ.",
    "url": "https://github.com/dat-lequoc"
  },
  "keywords": [
    "kiro",
    "kiro2api",
    "oauth",
    "reasoning",
    "openai",
    "anthropic",
    "gateway",
    "proxy",
    "docker"
  ],
  "main": "lib/gateway/main.js",
  "files": [
    "lib/gateway/main.js",
    "web",
    "assets",
    "bin/kiro-nest.mjs",
    "README.md",
    "README.zh.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "bin": {
    "kiro-nest": "bin/kiro-nest.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "check": "npm run typecheck && npm test && npm run build && node --check lib/gateway/main.js",
    "gateway": "node src/gateway/main.ts",
    "gateway:dev": "node --watch src/gateway/main.ts",
    "gateway:start": "node lib/gateway/main.js",
    "pack:dist": "mkdir -p dist && npm pack --pack-destination dist",
    "typecheck": "tsc -b tsconfig.json --noEmit false --emitDeclarationOnly",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
